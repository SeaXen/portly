  "narrative": {
    "northStar": "The Obsidian Harbor",
    "overview": "Portly is an industrial, precision-engineered observatory for local networks, containers, and background services. Like the flight deck or shipping harbor control tower at night, the interface stays calm, deep, and dark, using light with surgical intention to communicate status, bandwidth flow, and system pressure. A daylight variant and a pure-black variant remap the same semantic tokens rather than inventing a second visual language.",
    "keyCharacteristics": [
      "Un-wrapping horizontal telemetry strips with live 60-point inline vector sparklines.",
      "Dual-font typography hierarchy: Inter for controls and metadata; JetBrains Mono tabular figures for sockets, ports, and metrics.",
      "High-contrast, tactile micro-interactions with visible focus rings and restrained 120-180ms transitions.",
      "Intentional density: Compact for high-volume sysadmin auditing, Comfy for glanceable wallboard displays."
    ],
    "rules": [
      {
        "name": "The Single-Voice Accent Rule",
        "body": "Primary periwinkle is reserved strictly for interactive state and primary affordances. It covers \u22645% of screen area at rest.",
        "section": "colors"
      },
      {
        "name": "The Status Sovereignty Rule",
        "body": "Semantic colors are never used for arbitrary aesthetic decoration. A red dot must always denote a dead process or port collision.",
        "section": "colors"
      },
      {
        "name": "The Semantic Token Rule",
        "body": "Component text uses var(--text), var(--muted), var(--accent), and the status tokens \u2014 never hard-coded palette hexes \u2014 so every theme remaps it correctly.",
        "section": "colors"
      },
      {
        "name": "The Tabular Number Rule",
        "body": "All numerical readouts strictly enforce font-variant-numeric: tabular-nums to guarantee jitter-free rendering during real-time streaming updates.",
        "section": "typography"
      },
      {
        "name": "The No-Kicker Rule",
        "body": "Section titles and cards never display uppercase micro-eyebrows or kickers above headings.",
        "section": "typography"
      },
      {
        "name": "The Boundary Hairline Rule",
        "body": "Deep black overlays always feature an interior 1px semi-transparent border simulating an illuminated edge.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve single-line horizontal layouts for the stats strip and toolbar at all screen widths.",
      "Do use font-variant-numeric: tabular-nums for any container holding ports, PIDs, bytes, or percentages.",
      "Do verify port availability before prompting users with port change migration dialogs.",
      "Do respect prefers-reduced-motion by disabling translation animations while preserving subtle opacity transitions.",
      "Do maintain safe mode by default for all destructive process and container actions.",
      "Do route category-colored text through .cat-text and set color-scheme per theme so native controls follow.",
      "Do make the app name the keyboard-focusable button inside clickable rows/cards; keep containers role-free."
    ],
    "donts": [
      "Don't use decorative gradient text or multi-color glow halos outside semantic statuses.",
      "Don't hide critical telemetry behind hover tooltips; prioritize glanceable numbers with inline context.",
      "Don't wrap the stats strip or toolbars onto multiple vertical rows.",
      "Don't perform destructive Docker container recreation without an automatic rollback snapshot.",
      "Don't use raw emoji in place of authored, accessible SVG iconography.",
      "Don't put role=\"button\" on a container that nests checkboxes, buttons, or links.",
      "Don't hard-code dark-palette hexes as component text colors; use the semantic tokens."
    ]
  }
}